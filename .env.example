# =============================================================================
# visitor-counter: пример переменных окружения.
# Скопируйте файл в `.env` (он в .gitignore) и при необходимости поправьте:
#     copy .env.example .env
# =============================================================================

# Адрес и порт веб-сервера. 127.0.0.1 - только локальный доступ,
# 0.0.0.0 - доступ из локальной сети (для показа с другого ноутбука).
HOST=127.0.0.1
PORT=8000

# Путь к весам YOLOv8n. Если файла нет, ultralytics скачает yolov8n.pt
# автоматически (~6 МБ) в текущую папку при первом запуске.
MODEL_PATH=yolov8n.pt

# Порог уверенности детектора person: ниже - больше ложных срабатываний,
# выше - можно потерять человека. 0.35 - компромисс для MVP.
CONF_THRESHOLD=0.35

# 1 - использовать MockVisitorCounter (без YOLO/torch, для проверки UI и API),
# 0 - реальный VisitorCounter (YOLOv8n + ByteTrack).
VISITOR_USE_MOCK=0

# --- Зарезервировано под следующие итерации MVP ------------------------------
# Устройство инференса: auto | cuda | cpu. auto - CUDA при наличии, иначе CPU.
# DEVICE=auto
# Папка для загруженных видео и результатов обработки.
# STORAGE_DIR=storage
# Максимальный размер загружаемого видео, МБ (защита от случайных гигабайтов).
# MAX_UPLOAD_MB=512
# Уровень логирования uvicorn: debug | info | warning | error.
# LOG_LEVEL=info
